PORT=3000
NODE_ENV=development

# PostgreSQL connection (matches docker-compose service "db" when running via Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_reservation
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d

# Seed admin account (created by `npm run db:seed`)
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@restaurant.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_TELEPHONE=0000000000
