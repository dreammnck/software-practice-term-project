        {
          "name": "Register user A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = Date.now() + '' + Math.floor(Math.random()*1000);",
                  "pm.collectionVariables.set('emailA', `a_${s}@test.com`);",
                  "pm.collectionVariables.set('emailB', `b_${s}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('no password field in response', () => pm.expect(pm.response.text()).to.not.include('\"password\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
