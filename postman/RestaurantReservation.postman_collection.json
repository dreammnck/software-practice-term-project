                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has restaurants', () => pm.expect(j.restaurants.length).to.be.above(0));",
                  "pm.test('has required fields', () => ['name','address','telephone','openTime','closeTime'].forEach(k => pm.expect(j.restaurants[0]).to.have.property(k)));",
